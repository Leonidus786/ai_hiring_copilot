# Local development configuration. Copy to backend/.env; never commit secrets.
APP_ENV=development
DATABASE_URL=sqlite:///./backend/data/ai_hiring_copilot.db
RESUME_STORAGE_DIR=./backend/data/resumes
AUTO_CREATE_DB=true
MAX_UPLOAD_SIZE_BYTES=5242880
MAX_PDF_PAGES=20
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# X-Tenant-ID and X-Actor-ID are LOCAL DEVELOPMENT identity headers only.
# They are not authentication. Replace with verified JWT/OIDC before deployment.
